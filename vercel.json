{
  "rewrites": [
    {
      "source": "/((?!api|\\.well-known|favicon|site\\.webmanifest|assets|.*\\.apk|.*\\.png|.*\\.svg|.*\\.ico|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=3600, public"
        }
      ]
    }
  ]
}
